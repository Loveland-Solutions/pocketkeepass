<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Deliberately NO INTERNET permission. PocketKeePass never talks to the network.
        If a library tries to add it, the merged manifest removes it here.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />

    <!-- Hides other apps' overlays while PocketKeePass is showing (security/Overlays.kt). -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />

    <!--
        Only whether the phone is online, so a save to a cloud file can wait for the connection
        (files/Connection.kt). It can't send or receive anything.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Lets PocketKeePass look up installed web browsers. Autofill only believes a website
        address reported by a browser whose signing certificate it has checked.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!--
        CredentialDependency (lint) is ignored on purpose: credentials-play-services-auth is for
        apps that use Google Password Manager. A passkey provider doesn't need it, and F-Droid
        doesn't allow Google Play Services.
    -->
    <application
        android:name=".PocketKeePassApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PocketKeePass"
        tools:ignore="CredentialDependency"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The autofill service. Only Android itself can connect to it (BIND_AUTOFILL_SERVICE),
            and the user has to choose PocketKeePass in Android's settings first.
        -->
        <service
            android:name=".autofill.PocketAutofillService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>

        <!-- Opened by a tap on an autofill suggestion, on top of the app being filled in. -->
        <activity
            android:name=".autofill.AutofillActivity"
            android:exported="false"
            android:theme="@style/Theme.PocketKeePass.Autofill"
            android:windowSoftInputMode="adjustResize" />

        <!--
            The passkey provider (Android 14+, off below that). Only Android itself can connect to
            it (BIND_CREDENTIAL_PROVIDER_SERVICE), once the user turns PocketKeePass on under
            Passwords, passkeys & accounts.
        -->
        <service
            android:name=".passkey.PocketPasskeyService"
            android:enabled="@bool/passkeys_supported"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE"
            tools:targetApi="34">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/credential_provider" />
        </service>

        <!-- Opened by Android's passkey sheet, on top of the site or app asking for a passkey. -->
        <activity
            android:name=".passkey.PasskeyActivity"
            android:enabled="@bool/passkeys_supported"
            android:exported="false"
            android:theme="@style/Theme.PocketKeePass.Autofill"
            android:windowSoftInputMode="adjustResize" />

        <!-- Auto-lock's background alarm. Only this app can send it. -->
        <receiver
            android:name=".security.AutoLockReceiver"
            android:exported="false" />

        <!-- Clears a copied field from the clipboard after its timeout. Only this app can send it. -->
        <receiver
            android:name=".security.ClipboardClearReceiver"
            android:exported="false" />

        <!--
            No downloadable emoji font. AndroidX would ask Google Play Services for one at every
            start, which tells Play Services the app ran and may download on our behalf. The
            phone's own emoji font is used instead. (MissingClass: the provider comes from a
            library the app only gets at run time, through AndroidX.)
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:ignore="MissingClass"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
