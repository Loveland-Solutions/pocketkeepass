<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Mac app's sandbox. No com.apple.security.network.client: the app can't connect to anything,
  like the Android app without the INTERNET permission. It reaches only the files the user picks.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>44H5SLX8KR.mn.lls.pocketkeepass.mac</string>
	</array>
</dict>
</plist>
