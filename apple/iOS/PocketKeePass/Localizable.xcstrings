                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Changes in %lld seconds"
                }
              }
            }
          }
        },
        "mn": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld секундын дараа солигдоно"
                }
              }
            }
          }
        }
      }
    },
    "Changes not saved": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Өөрчлөлтүүд хадгалагдсангүй"
          }
        }
      }
    },
    "Check now": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Одоо шалгах"
          }
        }
      }
    },
    "Checking %@ for changes…": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ дээрх өөрчлөлтийг шалгаж байна…"
          }
        }
      }
    },
    "Checking the file for changes…": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлын өөрчлөлтийг шалгаж байна…"
          }
        }
      }
    },
    "Choose a .kdbx file from this iPhone or from any cloud storage app, or start a new one.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ iPhone эсвэл дурын үүлэн хадгалах сангийн аппаас .kdbx файл сонгох, эсвэл шинээр эхлүүлнэ үү."
          }
        }
      }
    },
    "Choose a .kdbx file from this iPhone or from any cloud storage app.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ iPhone дээрээс эсвэл дурын үүлэн хадгалах сангийн аппаас .kdbx файл сонгоно уу."
          }
        }
      }
    },
    "Choose where to save it…": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хадгалах газраа сонгох…"
          }
        }
      }
    },
    "Clear copied fields after": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хуулсан талбарыг арилгах хугацаа"
          }
        }
      }
    },
    "Clipboard": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Түр санах ой"
          }
        }
      }
    },
    "Common": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Түгээмэл"
          }
        }
      }
    },
    "Copied %@. It clears in %@.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хуулсан: %1$@. %2$@ өнгөрөхөд арилна."
          }
        }
      }
    },
    "Copied fields stay on this iPhone: they aren’t sent to your other devices through Universal Clipboard.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хуулсан талбарууд энэ iPhone дээр үлдэнэ. Universal Clipboard ашиглан таны бусад төхөөрөмж рүү илгээгдэхгүй."
          }
        }
      }
    },
    "Copy %@": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ хуулах"
          }
        }
      }
    },
    "Create": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Үүсгэх"
          }
        }
      }
    },
    "Create new database": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Шинэ өгөгдлийн сан үүсгэх"
          }
        }
      }
    },
    "Creating… This takes a few seconds.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Үүсгэж байна… Хэдэн секунд болно."
          }
        }
      }
    },
    "Delete": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Устгах"
          }
        }
      }
    },
    "Delete for good?": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүрмөсөн устгах уу?"
          }
        }
      }
    },
    "Deleted.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Устгалаа."
          }
        }
      }
    },
    "Digits": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Цифр"
          }
        }
      }
    },
    "Discard": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хаях"
          }
        }
      }
    },
    "Discard mine and reload": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Минийхийг хаяж, дахин ачаалах"
          }
        }
      }
    },
    "Discard your changes?": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Өөрчлөлтөө хаях уу?"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Болсон"
          }
        }
      }
    },
    "Duplicate": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хувилах"
          }
        }
      }
    },
    "Edit": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Засах"
          }
        }
      }
    },
    "Edit entry": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Бичлэг засах"
          }
        }
      }
    },
    "Edit group": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүлэг засах"
          }
        }
      }
    },
    "Empty recycle bin": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хогийн савыг хоослох"
          }
        }
      }
    },
    "Engine": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хөдөлгүүр"
          }
        }
      }
    },
    "Every change you make is saved into the file straight away, and %@ uploads it from there. PocketKeePass can’t see when the upload has finished. While this iPhone is offline, your changes wait on it and go into the file once it’s back online.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Таны хийсэн өөрчлөлт бүр шууд файлд хадгалагдаж, %@ тэндээс нь байршуулна. PocketKeePass байршуулалт хэзээ дууссаныг харж чадахгүй. Энэ iPhone интернэтгүй үед таны өөрчлөлтүүд энд хүлээгдэж, дахин холбогдмогц файлд орно."
          }
        }
      }
    },
    "Every change you make is saved into the file straight away. If the file is in a storage app (such as Dropbox or OneDrive), that app uploads it from there: iOS doesn’t tell PocketKeePass which app holds the file, or when the upload has finished. While this iPhone is offline, your changes wait on it and go into the file once it’s back online.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Таны хийсэн өөрчлөлт бүр шууд файлд хадгалагдана. Хэрэв файл хадгалах сангийн аппад (жишээ нь Dropbox, OneDrive) байгаа бол тэр апп тэндээс нь байршуулна. Файл аль аппад байгаа, байршуулалт хэзээ дууссаныг iOS мэдэгддэггүй. Энэ iPhone интернэтгүй үед таны өөрчлөлтүүд энд хүлээгдэж, дахин холбогдмогц файлд орно."
          }
        }
      }
    },
    "Every kind you choose appears at least once.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Сонгосон төрөл бүр дор хаяж нэг удаа орно."
          }
        }
      }
    },
    "Every symbol on the keyboard: %@. Some sites reject a few of these; switch to Common if one does.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Гарын бүх тусгай тэмдэгт: %@. Зарим сайт эдгээрийн заримыг хүлээж авдаггүй; тийм бол «Түгээмэл» рүү шилжинэ үү."
          }
        }
      }
    },
    "Everything in the recycle bin is deleted for good. This can’t be undone. A new recycle bin appears the next time you delete something.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хогийн саван дахь бүх зүйл бүрмөсөн устна. Үүнийг буцаах боломжгүй. Дараа нь ямар нэг зүйл устгахад шинэ хогийн сав гарч ирнэ."
          }
        }
      }
    },
    "Fair": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Дунд зэрэг"
          }
        }
      }
    },
    "Field name": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Талбарын нэр"
          }
        }
      }
    },
    "For %@": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Сайт: %@"
          }
        }
      }
    },
    "Free and open-source software, licensed under the GPLv3.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "GPLv3 лицензтэй, үнэгүй, нээлттэй эхийн програм хангамж."
          }
        }
      }
    },
    "Generate another": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Дахин үүсгэх"
          }
        }
      }
    },
    "Generate password": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нууц үг үүсгэх"
          }
        }
      }
    },
    "Generated password": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Үүсгэсэн нууц үг"
          }
        }
      }
    },
    "Hidden": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нуусан"
          }
        }
      }
    },
    "Hidden while the screen is being recorded or shared.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Дэлгэцийг бичиж эсвэл хуваалцаж байх үед нуугдана."
          }
        }
      }
    },
    "Hide %@": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ нуух"
          }
        }
      }
    },
    "Hide password": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нууц үгийг нуух"
          }
        }
      }
    },
    "It’s also needed after every restart of the iPhone. Typing it now and then keeps you from forgetting it, and means a lost iPhone takes more than a face or fingerprint to open.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Мөн iPhone дахин асах бүрд үүнийг асууна. Ингэснээр та нууц үгээ мартахгүй, гээгдсэн утсыг зөвхөн царай эсвэл хурууны хээгээр нээх боломжгүй болно."
          }
        }
      }
    },
    "Keep editing": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Үргэлжлүүлэн засах"
          }
        }
      }
    },
    "Key file: %@": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Түлхүүр файл: %@"
          }
        }
      }
    },
    "Last changes from another device came in at %@: %@.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Өөр төхөөрөмжийн хамгийн сүүлийн өөрчлөлтүүд %1$@ цагт орж ирсэн: %2$@."
          }
        }
      }
    },
    "Last checked for changes from other devices %@.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Бусад төхөөрөмжийн өөрчлөлтийг хамгийн сүүлд %@ шалгасан."
          }
        }
      }
    },
    "Length": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Урт"
          }
        }
      }
    },
    "Length: %lld": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Урт: %lld"
          }
        }
      }
    },
    "Lock": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Түгжих"
          }
        }
      }
    },
    "Lock after": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Түгжих хугацаа"
          }
        }
      }
    },
    "Lock after this long without use, even in the background.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ашиглахгүй байх үед (ар талд байсан ч) энэ хугацааны дараа түгжинэ."
          }
        }
      }
    },
    "Lock anyway": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ямар ч байсан түгжих"
          }
        }
      }
    },
    "Lock when the iPhone locks": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone түгжигдэхэд түгжих"
          }
        }
      }
    },
    "Lock without saving?": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хадгалалгүй түгжих үү?"
          }
        }
      }
    },
    "Lowercase letters": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Жижиг үсэг"
          }
        }
      }
    },
    "Made a copy.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хуулбар үүсгэлээ."
          }
        }
      }
    },
    "Master password": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Үндсэн нууц үг"
          }
        }
      }
    },
    "More options": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Бусад сонголт"
          }
        }
      }
    },
    "Move": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Зөөх"
          }
        }
      }
    },
    "Move to recycle bin": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хогийн сав руу зөөх"
          }
        }
      }
    },
    "Move to the recycle bin?": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хогийн сав руу зөөх үү?"
          }
        }
      }
    },
    "Move “%@” to": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Зөөх газраа сонгоно уу: «%@»"
          }
        }
      }
    },
    "Moved to the recycle bin.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хогийн сав руу зөөлөө."
          }
        }
      }
    },
    "Moved.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Зөөлөө."
          }
        }
      }
    },
    "Name": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нэр"
          }
        }
      }
    },
    "New database": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Шинэ өгөгдлийн сан"
          }
        }
      }
    },
    "New entry": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Шинэ бичлэг"
          }
        }
      }
    },
    "New group": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Шинэ бүлэг"
          }
        }
      }
    },
    "Next time, open %@ with %@ instead of typing your master password. You can change this any time in settings.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Дараагийн удаа %1$@ өгөгдлийн санг үндсэн нууц үгээ бичихгүйгээр %2$@ ашиглан нээгээрэй. Үүнийг тохиргооноос хүссэн үедээ өөрчилж болно."
          }
        }
      }
    },
    "No symbols. Use this only if a site rejects all of them; make the password longer to make up for it.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Тусгай тэмдэгтгүй. Сайт бүгдийг нь хүлээж авахгүй үед л үүнийг ашиглаарай, мөн нөхөж нууц үгээ уртасгаарай."
          }
        }
      }
    },
    "None": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Байхгүй"
          }
        }
      }
    },
    "Not now": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Одоо биш"
          }
        }
      }
    },
    "Notes": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Тэмдэглэл"
          }
        }
      }
    },
    "Nothing has been changed on this iPhone since unlocking.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Түгжээ тайлснаас хойш энэ iPhone дээр юу ч өөрчлөөгүй."
          }
        }
      }
    },
    "One-time code": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нэг удаагийн код"
          }
        }
      }
    },
    "Only symbols that sites commonly accept: %@": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Сайтууд ихэвчлэн зөвшөөрдөг тэмдэгтүүд л: %@"
          }
        }
      }
    },
    "Open database": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Өгөгдлийн сан нээх"
          }
        }
      }
    },
    "Passkey": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нэвтрэх түлхүүр"
          }
        }
      }
    },
    "Password": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нууц үг"
          }
        }
      }
    },
    "Passwords": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нууц үгс"
          }
        }
      }
    },
    "PocketKeePass can’t open the database file anymore. It may have been moved, renamed, or deleted. Choose it again.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "PocketKeePass өгөгдлийн сангийн файлыг нээж чадахгүй байна. Файлыг зөөсөн, нэрийг нь өөрчилсөн эсвэл устгасан байж магадгүй. Дахин сонгоно уу."
          }
        }
      }
    },
    "PocketKeePass can’t open the key file anymore. It may have been moved, renamed, or deleted. Remove it and add it again.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "PocketKeePass түлхүүр файлыг нээж чадахгүй байна. Файлыг зөөсөн, нэрийг нь өөрчилсөн эсвэл устгасан байж магадгүй. Хасаад дахин нэмнэ үү."
          }
        }
      }
    },
    "PocketKeePass can’t write to the database file. It may have been moved or deleted, or the storage app may only allow reading it.\n\nYour changes stay here until the database locks. Save a copy to keep them.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "PocketKeePass өгөгдлийн сангийн файлд бичиж чадахгүй байна. Файлыг зөөсөн эсвэл устгасан, эсвэл хадгалах сангийн апп зөвхөн уншихыг зөвшөөрдөг байж магадгүй.\n\nӨгөгдлийн сан түгжигдэх хүртэл таны өөрчлөлтүүд энд үлдэнэ. Тэдгээрийг алдахгүйн тулд хуулбар хадгална уу."
          }
        }
      }
    },
    "PocketKeePass couldn’t save the backup into that file. Try another location.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "PocketKeePass нөөцийг тэр файлд хадгалж чадсангүй. Өөр байршил сонгоно уу."
          }
        }
      }
    },
    "PocketKeePass couldn’t write the backup into the database file. Save it as a new file instead.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "PocketKeePass нөөцийг өгөгдлийн сангийн файлд бичиж чадсангүй. Оронд нь шинэ файлаар хадгална уу."
          }
        }
      }
    },
    "PocketKeePass fills in passwords": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "PocketKeePass нууц үгсийг бөглөнө"
          }
        }
      }
    },
    "PocketKeePass is written with Claude, an AI model made by Anthropic.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "PocketKeePass нь Anthropic компанийн бүтээсэн хиймэл оюуны загвар болох Claude ашиглан бичигдсэн."
          }
        }
      }
    },
    "PocketKeePass kept a copy of this database from just before its last save here, on %@.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "PocketKeePass энэ өгөгдлийн сангийн сүүлчийн хадгалалтаас өмнөх хуулбарыг энэ iPhone дээр үлдээсэн байна (%@)."
          }
        }
      }
    },
    "PocketKeePass opens and saves KeePass databases (.kdbx). KeePass and its file format were created by Dominik Reichl (keepass.info). PocketKeePass is an independent app. It isn’t made or endorsed by the KeePass project and uses none of its code.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "PocketKeePass нь KeePass өгөгдлийн санг (.kdbx) нээж, хадгалдаг. KeePass болон түүний файлын форматыг Dominik Reichl (keepass.info) бүтээсэн. PocketKeePass бол бие даасан апп. Үүнийг KeePass төсөл хийгээгүй, дэмжээгүй бөгөөд тэдний кодыг огт ашигладаггүй."
          }
        }
      }
    },
    "Privacy policy": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нууцлалын бодлого"
          }
        }
      }
    },
    "Protect (hide and encrypt)": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хамгаалах (нууж, шифрлэх)"
          }
        }
      }
    },
    "Remove": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хасах"
          }
        }
      }
    },
    "Replace": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Солих"
          }
        }
      }
    },
    "Replace it with mine": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Минийхээр солих"
          }
        }
      }
    },
    "Restore backup": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нөөцийг сэргээх"
          }
        }
      }
    },
    "Restore the backup?": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нөөцийг сэргээх үү?"
          }
        }
      }
    },
    "Save": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хадгалах"
          }
        }
      }
    },
    "Save a copy…": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хуулбар хадгалах…"
          }
        }
      }
    },
    "Save as new file…": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Шинэ файлаар хадгалах…"
          }
        }
      }
    },
    "Save it in iCloud Drive or another storage app to use it on your other devices too, with PocketKeePass or any KeePass app.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Бусад төхөөрөмж дээрээ PocketKeePass эсвэл дурын KeePass аппаар ашиглахын тулд iCloud Drive эсвэл өөр хадгалах сангийн апп дээр хадгална уу."
          }
        }
      }
    },
    "Saved": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хадгалсан"
          }
        }
      }
    },
    "Saved a copy. The database still opens from its old file.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хуулбарыг хадгаллаа. Өгөгдлийн сан хуучин файлаасаа нээгдсээр байна."
          }
        }
      }
    },
    "Saving…": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хадгалж байна…"
          }
        }
      }
    },
    "Search entries": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Бичлэг хайх"
          }
        }
      }
    },
    "Separate tags with commas.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Шошгуудыг таслалаар тусгаарлана уу."
          }
        }
      }
    },
    "Set up %@ in the iPhone’s Settings to use this.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Үүнийг ашиглахын тулд Тохиргоо аппад %@ тохируулна уу."
          }
        }
      }
    },
    "Set up one-time code": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нэг удаагийн код тохируулах"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Тохиргоо"
          }
        }
      }
    },
    "Setup key": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Тохиргооны түлхүүр"
          }
        }
      }
    },
    "Show %@": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ харуулах"
          }
        }
      }
    },
    "Show password": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нууц үгийг харуулах"
          }
        }
      }
    },
    "Shows how syncing works and when it last happened": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Синк хэрхэн ажилладаг, хамгийн сүүлд хэзээ болсныг харуулна"
          }
        }
      }
    },
    "Strong": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хүчтэй"
          }
        }
      }
    },
    "Symbols": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Тусгай тэмдэгт"
          }
        }
      }
    },
    "Syncing": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Синк"
          }
        }
      }
    },
    "Syncing with %@": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Синк: %@"
          }
        }
      }
    },
    "Tags": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Шошго"
          }
        }
      }
    },
    "Tap a password field in Safari or another app, tap the key above the keyboard, and choose PocketKeePass. It asks for Face ID or your master password each time, and offers the entries saved for that website. iOS checks which website is asking. PocketKeePass doesn’t share your entries with iOS.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari эсвэл өөр аппын нууц үгийн талбар дээр дарж, гарын дээрх түлхүүрийн тэмдэг дээр дараад, PocketKeePass гэснийг сонгоно уу. Тэр бүрт Face ID эсвэл үндсэн нууц үгийг асууж, тухайн вэбсайтад хадгалсан бичлэгүүдийг санал болгоно. Аль вэбсайт асууж буйг iOS өөрөө шалгадаг. PocketKeePass таны бичлэгүүдийг iOS системтэй хуваалцдаггүй."
          }
        }
      }
    },
    "That group or entry isn’t in the database anymore.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Тэр бүлэг эсвэл бичлэг өгөгдлийн санд байхгүй болсон байна."
          }
        }
      }
    },
    "That key file couldn’t be read.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Тэр түлхүүр файлыг уншиж чадсангүй."
          }
        }
      }
    },
    "That’s the code right now. Enter it on the site to finish. It changes every %lld seconds.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Одоогийн код энэ. Тохиргоог дуусгахын тулд үүнийг сайтад оруулна уу. Код %lld секунд тутам солигдоно."
          }
        }
      }
    },
    "The backup was restored. Unlock it as usual.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нөөцийг сэргээлээ. Ердийнхөөрөө түгжээг нь тайлна уу."
          }
        }
      }
    },
    "The backup was saved as %@, but PocketKeePass can’t open it from there. Choose it with Change.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нөөцийг %@ нэрээр хадгаллаа, гэхдээ PocketKeePass түүнийг тэндээс нээж чадахгүй байна. «Солих» товчоор сонгоно уу."
          }
        }
      }
    },
    "The copy couldn’t be saved.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хуулбарыг хадгалж чадсангүй."
          }
        }
      }
    },
    "The database is locked.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Өгөгдлийн сан түгжээтэй байна."
          }
        }
      }
    },
    "The database’s security settings were changed on another device. Lock, then unlock it again to take in the changes.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Өгөгдлийн сангийн аюулгүй байдлын тохиргоог өөр төхөөрөмж дээр өөрчилсөн байна. Өөрчлөлтийг авахын тулд түгжээд, дахин түгжээг нь тайлна уу."
          }
        }
      }
    },
    "The file changed elsewhere": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлыг өөр газар өөрчилсөн байна"
          }
        }
      }
    },
    "The file didn’t read back correctly after saving, so the storage app may not have stored it properly. Try again, or save a copy to be safe.\n\nYour changes stay here until the database locks.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хадгалсны дараа файлыг буцааж уншихад зөрүүтэй гарсан тул хадгалах сангийн апп үүнийг зөв хадгалаагүй байж магадгүй. Дахин оролдох эсвэл найдвартай байлгахын тулд хуулбар хадгална уу.\n\nӨгөгдлийн сан түгжигдэх хүртэл таны өөрчлөлтүүд энд үлдэнэ."
          }
        }
      }
    },
    "The file is named after it. You can rename the file later.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл энэ нэрээр нэрлэгдэнэ. Файлын нэрийг дараа нь өөрчилж болно."
          }
        }
      }
    },
    "The file now holds a different database. Lock, then unlock it again.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлд одоо өөр өгөгдлийн сан байна. Түгжээд, дахин түгжээг нь тайлна уу."
          }
        }
      }
    },
    "The master password was changed on another device. Lock, then unlock with the new one.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Үндсэн нууц үгийг өөр төхөөрөмж дээр сольсон байна. Түгжээд, шинэ нууц үгээр түгжээг тайлна уу."
          }
        }
      }
    },
    "The new copy of the database failed its safety check, so it wasn’t saved.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Өгөгдлийн сангийн шинэ хуулбар аюулгүй байдлын шалгалтад тэнцээгүй тул хадгалсангүй."
          }
        }
      }
    },
    "The new database couldn’t be saved there. Try another location.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Шинэ өгөгдлийн санг тэнд хадгалж чадсангүй. Өөр газар сонгоно уу."
          }
        }
      }
    },
    "The new database was saved, but PocketKeePass can’t open it from there. Choose it with Open database.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Шинэ өгөгдлийн санг хадгалсан ч PocketKeePass түүнийг тэндээс нээж чадахгүй байна. «Өгөгдлийн сан нээх»-ээр сонгоно уу."
          }
        }
      }
    },
    "The password or key file is incorrect.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нууц үг эсвэл түлхүүр файл буруу байна."
          }
        }
      }
    },
    "The two passwords are different.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хоёр нууц үг өөр байна."
          }
        }
      }
    },
    "This database uses the older KDBX 3 format, and PocketKeePass only saves KDBX 4. Upgrading keeps everything in it. KeePass 2.35 or later, KeePassXC 2.3 or later, and current KeePass apps open KDBX 4, but apps that only know KDBX 3 won’t open the file after you save.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ өгөгдлийн сан хуучин KDBX 3 форматтай бөгөөд PocketKeePass зөвхөн KDBX 4 форматаар хадгалдаг. Шинэчлэхэд доторх бүх зүйл хэвээр үлдэнэ. KeePass 2.35, KeePassXC 2.3 болон тэдгээрээс хойшх хувилбарууд, мөн одоогийн KeePass аппууд KDBX 4 файлыг нээдэг. Харин зөвхөн KDBX 3 мэддэг аппууд таныг хадгалсны дараа файлыг нээж чадахгүй."
          }
        }
      }
    },
    "This database uses the older KDBX 3 format. It has to be upgraded to KDBX 4 before it can be saved.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ өгөгдлийн сан хуучин KDBX 3 форматтай. Хадгалахаас өмнө KDBX 4 болгон шинэчлэх шаардлагатай."
          }
        }
      }
    },
    "This device couldn’t provide secure random numbers, so the database wasn’t saved.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ төхөөрөмж найдвартай санамсаргүй тоо гаргаж чадаагүй тул өгөгдлийн санг хадгалсангүй."
          }
        }
      }
    },
    "This entry is in the recycle bin.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ бичлэг хогийн саванд байна."
          }
        }
      }
    },
    "This group is empty.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ бүлэг хоосон байна."
          }
        }
      }
    },
    "This isn’t a KeePass database.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ нь KeePass өгөгдлийн сан биш байна."
          }
        }
      }
    },
    "This one password opens everything else, so make it long and memorable: several unrelated words work well. If it’s forgotten, nobody can open the database, not even us.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ ганц нууц үг бусад бүх зүйлийг нээдэг тул урт бөгөөд санахад хялбар болгоорой: хоорондоо холбоогүй хэдэн үг сайн тохирно. Мартвал хэн ч, бид ч гэсэн өгөгдлийн санг нээж чадахгүй."
          }
        }
      }
    },
    "This replaces %@ with the copy from %@. Changes made after that, here or on another device, will be lost.\n\nIf the file is still syncing from another device, wait for it to finish first, or choose “Save as new file” instead, which leaves the file alone.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ файлыг нөөц хуулбараар (%2$@) солино. Түүнээс хойш энд эсвэл өөр төхөөрөмж дээр хийсэн өөрчлөлтүүд алга болно.\n\nХэрэв файл өөр төхөөрөмжөөс синк хийгдсээр байгаа бол дуусахыг нь хүлээнэ үү. Эсвэл оронд нь «Шинэ файлаар хадгалах» товчийг дарна уу: энэ нь одоогийн файлд хүрэхгүй."
          }
        }
      }
    },
    "This replaces the entry’s current one-time code.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ нь бичлэгийн одоогийн нэг удаагийн кодыг орлоно."
          }
        }
      }
    },
    "Title": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Гарчиг"
          }
        }
      }
    },
    "Try again": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Дахин оролдох"
          }
        }
      }
    },
    "Turn on": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Асаах"
          }
        }
      }
    },
    "Turn on AutoFill": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматаар бөглөхийг асаах"
          }
        }
      }
    },
    "Turn on unlocking with %@": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ашиглан түгжээ тайлахыг асаах"
          }
        }
      }
    },
    "Type it again": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Дахин бичих"
          }
        }
      }
    },
    "Type the master password again.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Үндсэн нууц үгээ дахин бичнэ үү."
          }
        }
      }
    },
    "Type your master password this time. PocketKeePass asks for it after the iPhone restarts and every %lld days, so you don’t forget it.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Type your master password this time. PocketKeePass asks for it after the iPhone restarts and every day, so you don’t forget it."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Type your master password this time. PocketKeePass asks for it after the iPhone restarts and every %lld days, so you don’t forget it."
                }
              }
            }
          }
        },
        "mn": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Энэ удаа үндсэн нууц үгээ бичнэ үү. Мартахгүйн тулд PocketKeePass үүнийг iPhone дахин асах бүрд болон өдөр бүр асуудаг."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Энэ удаа үндсэн нууц үгээ бичнэ үү. Мартахгүйн тулд PocketKeePass үүнийг iPhone дахин асах бүрд болон %lld өдөр тутам асуудаг."
                }
              }
            }
          }
        }
      }
    },
    "URL": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "URL"
          }
        }
      }
    },
    "Unlock": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Түгжээ тайлах"
          }
        }
      }
    },
    "Unlock %@": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Түгжээг тайлах: %@"
          }
        }
      }
    },
    "Unlock this database with %@": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ өгөгдлийн санг %@ ашиглан нээх"
          }
        }
      }
    },
    "Unlock with %@": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ашиглан түгжээ тайлах"
          }
        }
      }
    },
    "Unlock with %@?": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ашиглан нээх үү?"
          }
        }
      }
    },
    "Unlocking with %@ stays on.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ашиглан түгжээ тайлах тохиргоо асаалттай хэвээр байна."
          }
        }
      }
    },
    "Unlocking with %@ was turned off because the faces, fingerprints, or passcode on this iPhone changed. Unlock with your master password, then turn it back on in settings.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ iPhone дээрх царай, хурууны хээ эсвэл нууц код өөрчлөгдсөн тул %@ ашиглан түгжээ тайлахыг унтраалаа. Үндсэн нууц үгээрээ түгжээг тайлаад, тохиргооноос дахин асаана уу."
          }
        }
      }
    },
    "Unlocking with %@ was turned off because this database’s master password or key file changed. Unlock with the new one, then turn it back on in settings.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ өгөгдлийн сангийн үндсэн нууц үг эсвэл түлхүүр файл өөрчлөгдсөн тул %@ ашиглан түгжээ тайлахыг унтраалаа. Шинэ нууц үгээрээ түгжээг тайлаад, тохиргооноос дахин асаана уу."
          }
        }
      }
    },
    "Unlocking… This can take a few seconds.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Түгжээг тайлж байна… Хэдэн секунд болж магадгүй."
          }
        }
      }
    },
    "Up to date with %@ · checked %@": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@: сүүлийн хувилбар · %2$@ шалгасан"
          }
        }
      }
    },
    "Up to date with the file · checked %@": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл: сүүлийн хувилбар · %@ шалгасан"
          }
        }
      }
    },
    "Updated from %@: %@": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Шинэчлэгдлээ (%1$@): %2$@"
          }
        }
      }
    },
    "Updated from another device: %@": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Өөр төхөөрөмжөөс шинэчлэгдлээ: %@"
          }
        }
      }
    },
    "Upgrade": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Шинэчлэх"
          }
        }
      }
    },
    "Upgrade to KDBX 4?": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "KDBX 4 болгон шинэчлэх үү?"
          }
        }
      }
    },
    "Uppercase letters": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Том үсэг"
          }
        }
      }
    },
    "Use": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ашиглах"
          }
        }
      }
    },
    "Use master password": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Үндсэн нууц үг ашиглах"
          }
        }
      }
    },
    "Username": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хэрэглэгчийн нэр"
          }
        }
      }
    },
    "Value": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Утга"
          }
        }
      }
    },
    "Version": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хувилбар"
          }
        }
      }
    },
    "Very strong": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Маш хүчтэй"
          }
        }
      }
    },
    "Weak": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Сул"
          }
        }
      }
    },
    "What now?": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Одоо яах вэ?"
          }
        }
      }
    },
    "When a site turns on two-factor sign-in, it shows a QR code and, usually under “Can’t scan it?”, a setup key. Copy the key (or an otpauth:// link) and paste it here.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Сайт хоёр шаттай нэвтрэлтийг асаахад QR код, ихэвчлэн «Уншуулж чадахгүй байна уу?» гэсний доор тохиргооны түлхүүр харуулдаг. Тэр түлхүүрийг (эсвэл otpauth:// холбоосыг) хуулж энд буулгана уу."
          }
        }
      }
    },
    "While PocketKeePass is open, it checks the file every 30 seconds (or pull down on the list to check now) and takes in changes made on other devices. If two devices changed the database at the same time, both sets of changes are kept. When an entry was changed in both places, the newer version is kept and the other goes into its history.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "PocketKeePass нээлттэй байх үедээ файлыг 30 секунд тутам шалгаж (одоо шалгах бол жагсаалтыг доош татна уу), бусад төхөөрөмж дээр хийсэн өөрчлөлтүүдийг авна. Хоёр төхөөрөмж өгөгдлийн санг нэгэн зэрэг өөрчилсөн бол хоёулангийнх нь өөрчлөлт хадгалагдана. Нэг бичлэгийг хоёр газар өөрчилсөн бол шинэ хувилбар нь үлдэж, нөгөө нь түүний түүхэнд орно."
          }
        }
      }
    },
    "Your KeePass passwords, free and offline.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Таны KeePass нууц үгнүүд — үнэгүй, интернэтгүй."
          }
        }
      }
    },
    "Your changes aren’t saved to the file yet. Locking discards them.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Таны өөрчлөлтүүд файлд хараахан хадгалагдаагүй байна. Түгжвэл тэдгээр нь устна."
          }
        }
      }
    },
    "Your changes aren’t saved to the file.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Таны өөрчлөлтүүд файлд хадгалагдаагүй байна."
          }
        }
      }
    },
    "Your last change was saved to the file at %@.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Таны сүүлийн өөрчлөлтийг файлд %@ цагт хадгалсан."
          }
        }
      }
    },
    "You’re offline. Your changes are kept on this iPhone and go into the file once you’re back online.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Та интернэтгүй байна. Таны өөрчлөлтүүд энэ iPhone дээр хадгалагдсан бөгөөд дахин холбогдмогц файлд орно."
          }
        }
      }
    },
    "iCloud Drive": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive"
          }
        }
      }
    },
    "just now": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "дөнгөж сая"
          }
        }
      }
    },
    "“%@” and everything in it are deleted for good. This can’t be undone.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» болон доторх бүх зүйл бүрмөсөн устна. Үүнийг буцаах боломжгүй."
          }
        }
      }
    },
    "“%@” and everything in it go to the recycle bin. You can move them back out from there.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» болон доторх бүх зүйл хогийн сав руу орно. Тэндээс буцааж гаргаж болно."
          }
        }
      }
    },
    "“%@” goes to the recycle bin. You can move it back out from there.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» хогийн сав руу орно. Тэндээс буцааж гаргаж болно."
          }
        }
      }
    },
    "“%@” is deleted for good. This can’t be undone.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» бүрмөсөн устна. Үүнийг буцаах боломжгүй."
          }
        }
      }
    }
  },
  "version": "1.0"
}
