    "(no name)": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "(нэргүй)"
          }
        }
      }
    },
    "(no title)": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "(гарчиггүй)"
          }
        }
      }
    },
    "A passkey for this account is already in the database.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ бүртгэлийн нэвтрэх түлхүүр өгөгдлийн санд аль хэдийн байна."
          }
        }
      }
    },
    "About": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Тухай"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нэмэх"
          }
        }
      }
    },
    "Add field": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Талбар нэмэх"
          }
        }
      }
    },
    "Add key file": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Түлхүүр файл нэмэх"
          }
        }
      }
    },
    "An independent app for KeePass databases. Written with Claude.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "KeePass өгөгдлийн санд зориулсан бие даасан апп. Claude ашиглан бичсэн."
          }
        }
      }
    },
    "Another app or device changed the database file, and PocketKeePass can’t combine those changes with yours: the file may have a new master password, hold another database, or be damaged. Saving now would replace it with yours.\n\nYour changes stay here until the database locks.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Өөр апп эсвэл төхөөрөмж өгөгдлийн сангийн файлыг өөрчилсөн бөгөөд PocketKeePass тэр өөрчлөлтүүдийг таныхтай нэгтгэж чадахгүй байна: файл шинэ үндсэн нууц үгтэй болсон, өөр өгөгдлийн сан агуулж байгаа эсвэл гэмтсэн байж магадгүй. Одоо хадгалвал тэр файлыг таныхаар солино.\n\nӨгөгдлийн сан түгжигдэх хүртэл таны өөрчлөлтүүд энд үлдэнэ."
          }
        }
      }
    },
    "Anyone whose face or fingerprint is set up on this iPhone can then open it. Changing those turns this off, and your master password is always needed to turn it back on.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ингэвэл энэ iPhone дээр царай эсвэл хурууны хээ нь бүртгэлтэй хэн ч үүнийг нээж чадна. Тэдгээрийг өөрчлөхөд энэ тохиргоо унтарч, дахин асаахад үргэлж үндсэн нууц үг шаардлагатай."
          }
        }
      }
    },
    "Ask for the master password every": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Үндсэн нууц үгийг дахин асуух давтамж"
          }
        }
      }
    },
    "Auto-lock": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Автомат түгжээ"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Цуцлах"
          }
        }
      }
    },
    "Can’t read the file right now. Changes from other devices will come in once it can.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Яг одоо файлыг уншиж чадахгүй байна. Уншиж чадмагц бусад төхөөрөмжийн өөрчлөлтүүд орж ирнэ."
          }
        }
      }
    },
    "Change": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Солих"
          }
        }
      }
    },
    "Change %@": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ өөрчлөх"
          }
        }
      }
    },
    "Changes in %lld seconds": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Changes in %lld second"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Changes in %lld seconds"
                }
              }
            }
          }
        },
        "mn": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld секундын дараа солигдоно"
                }
              }
            }
          }
        }
      }
    },
    "Changes not saved": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Өөрчлөлтүүд хадгалагдсангүй"
          }
        }
      }
    },
    "Choose a .kdbx file from this iPhone or from any cloud storage app.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ iPhone дээрээс эсвэл дурын үүлэн хадгалах сангийн аппаас .kdbx файл сонгоно уу."
          }
        }
      }
    },
    "Clear copied fields after": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хуулсан талбарыг арилгах хугацаа"
          }
        }
      }
    },
    "Clipboard": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Түр санах ой"
          }
        }
      }
    },
    "Copied %@. It clears in %@.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хуулсан: %1$@. %2$@ өнгөрөхөд арилна."
          }
        }
      }
    },
    "Copied fields stay on this iPhone: they aren’t sent to your other devices through Universal Clipboard.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хуулсан талбарууд энэ iPhone дээр үлдэнэ. Universal Clipboard ашиглан таны бусад төхөөрөмж рүү илгээгдэхгүй."
          }
        }
      }
    },
    "Copy %@": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ хуулах"
          }
        }
      }
    },
    "Delete": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Устгах"
          }
        }
      }
    },
    "Delete for good?": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүрмөсөн устгах уу?"
          }
        }
      }
    },
    "Deleted.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Устгалаа."
          }
        }
      }
    },
    "Discard": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хаях"
          }
        }
      }
    },
    "Discard mine and reload": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Минийхийг хаяж, дахин ачаалах"
          }
        }
      }
    },
    "Discard your changes?": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Өөрчлөлтөө хаях уу?"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Болсон"
          }
        }
      }
    },
    "Duplicate": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хувилах"
          }
        }
      }
    },
    "Edit": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Засах"
          }
        }
      }
    },
    "Edit entry": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Бичлэг засах"
          }
        }
      }
    },
    "Edit group": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Бүлэг засах"
          }
        }
      }
    },
    "Empty recycle bin": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хогийн савыг хоослох"
          }
        }
      }
    },
    "Engine": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хөдөлгүүр"
          }
        }
      }
    },
    "Everything in the recycle bin is deleted for good. This can’t be undone. A new recycle bin appears the next time you delete something.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хогийн саван дахь бүх зүйл бүрмөсөн устна. Үүнийг буцаах боломжгүй. Дараа нь ямар нэг зүйл устгахад шинэ хогийн сав гарч ирнэ."
          }
        }
      }
    },
    "Field name": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Талбарын нэр"
          }
        }
      }
    },
    "For %@": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Сайт: %@"
          }
        }
      }
    },
    "Free and open-source software, licensed under the GPLv3.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "GPLv3 лицензтэй, үнэгүй, нээлттэй эхийн програм хангамж."
          }
        }
      }
    },
    "Hidden": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нуусан"
          }
        }
      }
    },
    "Hidden while the screen is being recorded or shared.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Дэлгэцийг бичиж эсвэл хуваалцаж байх үед нуугдана."
          }
        }
      }
    },
    "Hide %@": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ нуух"
          }
        }
      }
    },
    "Hide password": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нууц үгийг нуух"
          }
        }
      }
    },
    "It’s also needed after every restart of the iPhone. Typing it now and then keeps you from forgetting it, and means a lost iPhone takes more than a face or fingerprint to open.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Мөн iPhone дахин асах бүрд үүнийг асууна. Ингэснээр та нууц үгээ мартахгүй, гээгдсэн утсыг зөвхөн царай эсвэл хурууны хээгээр нээх боломжгүй болно."
          }
        }
      }
    },
    "Keep editing": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Үргэлжлүүлэн засах"
          }
        }
      }
    },
    "Key file: %@": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Түлхүүр файл: %@"
          }
        }
      }
    },
    "Lock": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Түгжих"
          }
        }
      }
    },
    "Lock after": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Түгжих хугацаа"
          }
        }
      }
    },
    "Lock after this long without use, even in the background.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ашиглахгүй байх үед (ар талд байсан ч) энэ хугацааны дараа түгжинэ."
          }
        }
      }
    },
    "Lock anyway": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Ямар ч байсан түгжих"
          }
        }
      }
    },
    "Lock when the iPhone locks": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone түгжигдэхэд түгжих"
          }
        }
      }
    },
    "Lock without saving?": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хадгалалгүй түгжих үү?"
          }
        }
      }
    },
    "Made a copy.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хуулбар үүсгэлээ."
          }
        }
      }
    },
    "Master password": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Үндсэн нууц үг"
          }
        }
      }
    },
    "More options": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Бусад сонголт"
          }
        }
      }
    },
    "Move": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Зөөх"
          }
        }
      }
    },
    "Move to recycle bin": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хогийн сав руу зөөх"
          }
        }
      }
    },
    "Move to the recycle bin?": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хогийн сав руу зөөх үү?"
          }
        }
      }
    },
    "Move “%@” to": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Зөөх газраа сонгоно уу: «%@»"
          }
        }
      }
    },
    "Moved to the recycle bin.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хогийн сав руу зөөлөө."
          }
        }
      }
    },
    "Moved.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Зөөлөө."
          }
        }
      }
    },
    "Name": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нэр"
          }
        }
      }
    },
    "New entry": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Шинэ бичлэг"
          }
        }
      }
    },
    "New group": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Шинэ бүлэг"
          }
        }
      }
    },
    "Next time, open %@ with %@ instead of typing your master password. You can change this any time in settings.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Дараагийн удаа %1$@ өгөгдлийн санг үндсэн нууц үгээ бичихгүйгээр %2$@ ашиглан нээгээрэй. Үүнийг тохиргооноос хүссэн үедээ өөрчилж болно."
          }
        }
      }
    },
    "Not now": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Одоо биш"
          }
        }
      }
    },
    "Notes": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Тэмдэглэл"
          }
        }
      }
    },
    "One-time code": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нэг удаагийн код"
          }
        }
      }
    },
    "Open database": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Өгөгдлийн сан нээх"
          }
        }
      }
    },
    "Passkey": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нэвтрэх түлхүүр"
          }
        }
      }
    },
    "Password": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нууц үг"
          }
        }
      }
    },
    "PocketKeePass can’t open the database file anymore. It may have been moved, renamed, or deleted. Choose it again.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "PocketKeePass өгөгдлийн сангийн файлыг нээж чадахгүй байна. Файлыг зөөсөн, нэрийг нь өөрчилсөн эсвэл устгасан байж магадгүй. Дахин сонгоно уу."
          }
        }
      }
    },
    "PocketKeePass can’t open the key file anymore. It may have been moved, renamed, or deleted. Remove it and add it again.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "PocketKeePass түлхүүр файлыг нээж чадахгүй байна. Файлыг зөөсөн, нэрийг нь өөрчилсөн эсвэл устгасан байж магадгүй. Хасаад дахин нэмнэ үү."
          }
        }
      }
    },
    "PocketKeePass can’t write to the database file. It may have been moved or deleted, or the storage app may only allow reading it.\n\nYour changes stay here until the database locks. Save a copy to keep them.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "PocketKeePass өгөгдлийн сангийн файлд бичиж чадахгүй байна. Файлыг зөөсөн эсвэл устгасан, эсвэл хадгалах сангийн апп зөвхөн уншихыг зөвшөөрдөг байж магадгүй.\n\nӨгөгдлийн сан түгжигдэх хүртэл таны өөрчлөлтүүд энд үлдэнэ. Тэдгээрийг алдахгүйн тулд хуулбар хадгална уу."
          }
        }
      }
    },
    "PocketKeePass is written with Claude, an AI model made by Anthropic.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "PocketKeePass нь Anthropic компанийн бүтээсэн хиймэл оюуны загвар болох Claude ашиглан бичигдсэн."
          }
        }
      }
    },
    "PocketKeePass opens and saves KeePass databases (.kdbx). KeePass and its file format were created by Dominik Reichl (keepass.info). PocketKeePass is an independent app. It isn’t made or endorsed by the KeePass project and uses none of its code.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "PocketKeePass нь KeePass өгөгдлийн санг (.kdbx) нээж, хадгалдаг. KeePass болон түүний файлын форматыг Dominik Reichl (keepass.info) бүтээсэн. PocketKeePass бол бие даасан апп. Үүнийг KeePass төсөл хийгээгүй, дэмжээгүй бөгөөд тэдний кодыг огт ашигладаггүй."
          }
        }
      }
    },
    "Privacy policy": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нууцлалын бодлого"
          }
        }
      }
    },
    "Protect (hide and encrypt)": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хамгаалах (нууж, шифрлэх)"
          }
        }
      }
    },
    "Remove": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хасах"
          }
        }
      }
    },
    "Replace it with mine": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Минийхээр солих"
          }
        }
      }
    },
    "Save": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хадгалах"
          }
        }
      }
    },
    "Save a copy…": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хуулбар хадгалах…"
          }
        }
      }
    },
    "Saved": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хадгалсан"
          }
        }
      }
    },
    "Saved a copy. The database still opens from its old file.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хуулбарыг хадгаллаа. Өгөгдлийн сан хуучин файлаасаа нээгдсээр байна."
          }
        }
      }
    },
    "Saving…": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хадгалж байна…"
          }
        }
      }
    },
    "Search entries": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Бичлэг хайх"
          }
        }
      }
    },
    "Separate tags with commas.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Шошгуудыг таслалаар тусгаарлана уу."
          }
        }
      }
    },
    "Set up %@ in the iPhone’s Settings to use this.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Үүнийг ашиглахын тулд Тохиргоо аппад %@ тохируулна уу."
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Тохиргоо"
          }
        }
      }
    },
    "Show %@": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ харуулах"
          }
        }
      }
    },
    "Show password": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нууц үгийг харуулах"
          }
        }
      }
    },
    "Tags": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Шошго"
          }
        }
      }
    },
    "That group or entry isn’t in the database anymore.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Тэр бүлэг эсвэл бичлэг өгөгдлийн санд байхгүй болсон байна."
          }
        }
      }
    },
    "That key file couldn’t be read.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Тэр түлхүүр файлыг уншиж чадсангүй."
          }
        }
      }
    },
    "The copy couldn’t be saved.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хуулбарыг хадгалж чадсангүй."
          }
        }
      }
    },
    "The database is locked.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Өгөгдлийн сан түгжээтэй байна."
          }
        }
      }
    },
    "The database’s security settings were changed on another device. Lock, then unlock it again to take in the changes.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Өгөгдлийн сангийн аюулгүй байдлын тохиргоог өөр төхөөрөмж дээр өөрчилсөн байна. Өөрчлөлтийг авахын тулд түгжээд, дахин түгжээг нь тайлна уу."
          }
        }
      }
    },
    "The file changed elsewhere": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлыг өөр газар өөрчилсөн байна"
          }
        }
      }
    },
    "The file didn’t read back correctly after saving, so the storage app may not have stored it properly. Try again, or save a copy to be safe.\n\nYour changes stay here until the database locks.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хадгалсны дараа файлыг буцааж уншихад зөрүүтэй гарсан тул хадгалах сангийн апп үүнийг зөв хадгалаагүй байж магадгүй. Дахин оролдох эсвэл найдвартай байлгахын тулд хуулбар хадгална уу.\n\nӨгөгдлийн сан түгжигдэх хүртэл таны өөрчлөлтүүд энд үлдэнэ."
          }
        }
      }
    },
    "The file now holds a different database. Lock, then unlock it again.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлд одоо өөр өгөгдлийн сан байна. Түгжээд, дахин түгжээг нь тайлна уу."
          }
        }
      }
    },
    "The master password was changed on another device. Lock, then unlock with the new one.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Үндсэн нууц үгийг өөр төхөөрөмж дээр сольсон байна. Түгжээд, шинэ нууц үгээр түгжээг тайлна уу."
          }
        }
      }
    },
    "The new copy of the database failed its safety check, so it wasn’t saved.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Өгөгдлийн сангийн шинэ хуулбар аюулгүй байдлын шалгалтад тэнцээгүй тул хадгалсангүй."
          }
        }
      }
    },
    "The password or key file is incorrect.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Нууц үг эсвэл түлхүүр файл буруу байна."
          }
        }
      }
    },
    "This database uses the older KDBX 3 format, and PocketKeePass only saves KDBX 4. Upgrading keeps everything in it. KeePass 2.35 or later, KeePassXC 2.3 or later, and current KeePass apps open KDBX 4, but apps that only know KDBX 3 won’t open the file after you save.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ өгөгдлийн сан хуучин KDBX 3 форматтай бөгөөд PocketKeePass зөвхөн KDBX 4 форматаар хадгалдаг. Шинэчлэхэд доторх бүх зүйл хэвээр үлдэнэ. KeePass 2.35, KeePassXC 2.3 болон тэдгээрээс хойшх хувилбарууд, мөн одоогийн KeePass аппууд KDBX 4 файлыг нээдэг. Харин зөвхөн KDBX 3 мэддэг аппууд таныг хадгалсны дараа файлыг нээж чадахгүй."
          }
        }
      }
    },
    "This database uses the older KDBX 3 format. It has to be upgraded to KDBX 4 before it can be saved.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ өгөгдлийн сан хуучин KDBX 3 форматтай. Хадгалахаас өмнө KDBX 4 болгон шинэчлэх шаардлагатай."
          }
        }
      }
    },
    "This device couldn’t provide secure random numbers, so the database wasn’t saved.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ төхөөрөмж найдвартай санамсаргүй тоо гаргаж чадаагүй тул өгөгдлийн санг хадгалсангүй."
          }
        }
      }
    },
    "This entry is in the recycle bin.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ бичлэг хогийн саванд байна."
          }
        }
      }
    },
    "This group is empty.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ бүлэг хоосон байна."
          }
        }
      }
    },
    "This isn’t a KeePass database.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ нь KeePass өгөгдлийн сан биш байна."
          }
        }
      }
    },
    "Title": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Гарчиг"
          }
        }
      }
    },
    "Try again": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Дахин оролдох"
          }
        }
      }
    },
    "Turn on": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Асаах"
          }
        }
      }
    },
    "Turn on unlocking with %@": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ашиглан түгжээ тайлахыг асаах"
          }
        }
      }
    },
    "Type your master password this time. PocketKeePass asks for it after the iPhone restarts and every %lld days, so you don’t forget it.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Type your master password this time. PocketKeePass asks for it after the iPhone restarts and every day, so you don’t forget it."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Type your master password this time. PocketKeePass asks for it after the iPhone restarts and every %lld days, so you don’t forget it."
                }
              }
            }
          }
        },
        "mn": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Энэ удаа үндсэн нууц үгээ бичнэ үү. Мартахгүйн тулд PocketKeePass үүнийг iPhone дахин асах бүрд болон өдөр бүр асуудаг."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Энэ удаа үндсэн нууц үгээ бичнэ үү. Мартахгүйн тулд PocketKeePass үүнийг iPhone дахин асах бүрд болон %lld өдөр тутам асуудаг."
                }
              }
            }
          }
        }
      }
    },
    "URL": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "URL"
          }
        }
      }
    },
    "Unlock": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Түгжээ тайлах"
          }
        }
      }
    },
    "Unlock %@": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Түгжээг тайлах: %@"
          }
        }
      }
    },
    "Unlock this database with %@": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ өгөгдлийн санг %@ ашиглан нээх"
          }
        }
      }
    },
    "Unlock with %@": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ашиглан түгжээ тайлах"
          }
        }
      }
    },
    "Unlock with %@?": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ашиглан нээх үү?"
          }
        }
      }
    },
    "Unlocking with %@ stays on.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ашиглан түгжээ тайлах тохиргоо асаалттай хэвээр байна."
          }
        }
      }
    },
    "Unlocking with %@ was turned off because the faces, fingerprints, or passcode on this iPhone changed. Unlock with your master password, then turn it back on in settings.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ iPhone дээрх царай, хурууны хээ эсвэл нууц код өөрчлөгдсөн тул %@ ашиглан түгжээ тайлахыг унтраалаа. Үндсэн нууц үгээрээ түгжээг тайлаад, тохиргооноос дахин асаана уу."
          }
        }
      }
    },
    "Unlocking with %@ was turned off because this database’s master password or key file changed. Unlock with the new one, then turn it back on in settings.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Энэ өгөгдлийн сангийн үндсэн нууц үг эсвэл түлхүүр файл өөрчлөгдсөн тул %@ ашиглан түгжээ тайлахыг унтраалаа. Шинэ нууц үгээрээ түгжээг тайлаад, тохиргооноос дахин асаана уу."
          }
        }
      }
    },
    "Unlocking… This can take a few seconds.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Түгжээг тайлж байна… Хэдэн секунд болж магадгүй."
          }
        }
      }
    },
    "Updated from %@: %@": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Шинэчлэгдлээ (%1$@): %2$@"
          }
        }
      }
    },
    "Updated from another device: %@": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Өөр төхөөрөмжөөс шинэчлэгдлээ: %@"
          }
        }
      }
    },
    "Upgrade": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Шинэчлэх"
          }
        }
      }
    },
    "Upgrade to KDBX 4?": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "KDBX 4 болгон шинэчлэх үү?"
          }
        }
      }
    },
    "Use master password": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Үндсэн нууц үг ашиглах"
          }
        }
      }
    },
    "Username": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хэрэглэгчийн нэр"
          }
        }
      }
    },
    "Value": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Утга"
          }
        }
      }
    },
    "Version": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хувилбар"
          }
        }
      }
    },
    "What now?": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Одоо яах вэ?"
          }
        }
      }
    },
    "Your KeePass passwords, free and offline.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Таны KeePass нууц үгнүүд — үнэгүй, интернэтгүй."
          }
        }
      }
    },
    "Your changes aren’t saved to the file yet. Locking discards them.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Таны өөрчлөлтүүд файлд хараахан хадгалагдаагүй байна. Түгжвэл тэдгээр нь устна."
          }
        }
      }
    },
    "Your changes aren’t saved to the file.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Таны өөрчлөлтүүд файлд хадгалагдаагүй байна."
          }
        }
      }
    },
    "You’re offline. Your changes are kept on this iPhone and go into the file once you’re back online.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Та интернэтгүй байна. Таны өөрчлөлтүүд энэ iPhone дээр хадгалагдсан бөгөөд дахин холбогдмогц файлд орно."
          }
        }
      }
    },
    "iCloud Drive": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive"
          }
        }
      }
    },
    "“%@” and everything in it are deleted for good. This can’t be undone.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» болон доторх бүх зүйл бүрмөсөн устна. Үүнийг буцаах боломжгүй."
          }
        }
      }
    },
    "“%@” and everything in it go to the recycle bin. You can move them back out from there.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» болон доторх бүх зүйл хогийн сав руу орно. Тэндээс буцааж гаргаж болно."
          }
        }
      }
    },
    "“%@” goes to the recycle bin. You can move it back out from there.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» хогийн сав руу орно. Тэндээс буцааж гаргаж болно."
          }
        }
      }
    },
    "“%@” is deleted for good. This can’t be undone.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» бүрмөсөн устна. Үүнийг буцаах боломжгүй."
          }
        }
      }
    }
  },
  "version": "1.0"
}
