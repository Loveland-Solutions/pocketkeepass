{
  "sourceLanguage": "en",
  "strings": {
    "%@\n\nYour changes stay here until the database locks.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nӨгөгдлийн сан түгжигдэх хүртэл таны өөрчлөлтүүд энд үлдэнэ."
          }
        }
      }
    },
    "%@ can’t be used by PocketKeePass right now. Check in the iPhone’s Settings that a passcode and %@ are set up, and that PocketKeePass is allowed to use %@.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "PocketKeePass одоогоор %1$@ ашиглах боломжгүй байна. Тохиргоо аппад нууц код болон %2$@ тохируулсан эсэх, мөн PocketKeePass апп %3$@ ашиглах зөвшөөрөлтэй эсэхийг шалгана уу."
          }
        }
      }
    },
    "%@ is locked after too many tries. Use your master password, or unlock the iPhone with its passcode to turn %@ back on.": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "Хэт олон удаа оролдсон тул %1$@ түр түгжигдлээ. Үндсэн нууц үгээ ашиглана уу. Эсвэл утасны түгжээг нууц кодоор тайлбал %2$@ дахин ажиллана."
          }
        }
      }
    },
    "%@, %@": {
      "localizations": {
        "mn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@"
          }
        }
      }
    },
    "%lld entries": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
