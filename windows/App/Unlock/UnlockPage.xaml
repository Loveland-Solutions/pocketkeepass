<Page
    x:Class="PocketKeePass.Unlock.UnlockPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <Grid MaxWidth="440" Margin="24,48" VerticalAlignment="Center">

            <!-- No database chosen yet. -->
            <StackPanel x:Name="WelcomePanel" Spacing="16" Visibility="Collapsed">
                <Image Source="ms-appx:///Assets/Square150x150Logo.png" Width="96" Height="96" HorizontalAlignment="Center"
                       AutomationProperties.AccessibilityView="Raw" />
                <TextBlock Text="PocketKeePass" Style="{StaticResource TitleLargeTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock x:Uid="WelcomeTagline" Style="{StaticResource SubtitleTextBlockStyle}"
                           TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                <Button x:Uid="OpenDatabaseButton" x:Name="OpenDatabaseButton" Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center" Click="OpenDatabase_Click" />
                <TextBlock x:Uid="OpenDatabaseHint" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                           TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Uid="Credits" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,24,0,0" />
                <HyperlinkButton x:Uid="AboutButton" x:Name="AboutButton" HorizontalAlignment="Center" Click="About_Click" />
            </StackPanel>

            <!-- A database chosen: its key. -->
            <StackPanel x:Name="UnlockPanel" Spacing="16" Visibility="Collapsed">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="DatabaseName" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="DatabaseFolder" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button x:Uid="ChangeDatabaseButton" x:Name="ChangeDatabaseButton" Grid.Column="1" VerticalAlignment="Top"
                            Click="OpenDatabase_Click" />
                </Grid>

                <!-- Peek: the reveal button shows the password only while it's held down. -->
                <PasswordBox x:Uid="PasswordBox" x:Name="PasswordBox" PasswordRevealMode="Peek" KeyDown="PasswordBox_KeyDown" />

                <Grid x:Name="KeyFileRow" ColumnSpacing="12" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="KeyFileName" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button x:Uid="RemoveKeyFileButton" x:Name="RemoveKeyFileButton" Grid.Column="1" Click="RemoveKeyFile_Click" />
                </Grid>
                <HyperlinkButton x:Uid="AddKeyFileButton" x:Name="AddKeyFileButton" Click="AddKeyFile_Click" Padding="0" />

                <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="False" />

                <Button x:Uid="UnlockButton" x:Name="UnlockButton" Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch" Click="Unlock_Click" />
                <StackPanel x:Name="UnlockingPanel" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
                    <ProgressRing IsActive="True" Width="20" Height="20" />
                    <TextBlock x:Uid="UnlockingText" TextWrapping="Wrap" VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>

                <TextBlock x:Uid="UnlockCredits" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,24,0,0" />
                <HyperlinkButton x:Uid="UnlockAboutButton" HorizontalAlignment="Center" Click="About_Click" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
