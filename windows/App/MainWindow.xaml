<Window
    x:Class="PocketKeePass.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="PocketKeePass">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="420">
        <TextBlock Text="PocketKeePass" Style="{StaticResource TitleLargeTextBlockStyle}" HorizontalAlignment="Center" />
        <TextBlock x:Name="EngineStatus" Style="{StaticResource BodyTextBlockStyle}" HorizontalAlignment="Center" />
        <TextBlock Text="An independent app for KeePass databases. Written with Claude."
                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
    </StackPanel>
</Window>
